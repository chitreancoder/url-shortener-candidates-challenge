# Local development (`pnpm dev`). Docker Compose sets its own values.
# PORT is not set here on purpose: server defaults to 4000, web to 3000.

# --- server (apps/server) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener
# Base of the short links: the API serves the redirect.
PUBLIC_URL=http://localhost:4000
# Unknown short codes redirect to ${WEB_URL}/not-found.
WEB_URL=http://localhost:3000

# --- web (apps/web) ---
API_URL=http://localhost:4000

# --- shared ---
# Lets the API trust the client IP the web app forwards for rate limiting (min 16 chars).
INTERNAL_API_KEY=local-dev-internal-key-change-me
